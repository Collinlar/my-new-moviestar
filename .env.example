# Supabase (required for build and runtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Legacy names also supported by lib/supabase/env.ts
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Optional: Netlify functions
# BASE_URL=https://muviestars.com
# INDEXNOW_KEY=your-indexnow-key

# Optional: YouTube Data API v3 key (Google Cloud console, free quota). Without it, link checks only learn whether
# a video exists and who owns it. With it they also learn length, captions and whether the video is blocked in Ghana.
# YOUTUBE_API_KEY=your-youtube-key
